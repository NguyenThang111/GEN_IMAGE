{
  "name": "auto2tech-os",
  "version": "0.1.0",
  "private": true,
  "description": "Auto2Tech OS - one shared Trash Stack for team execution",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @auto2tech/web",
    "dev:api": "npm run start:dev --workspace @auto2tech/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
    ,"test:e2e": "npm run test:e2e --workspace @auto2tech/api"
  },
  "engines": {
    "node": ">=20"
  }
}
